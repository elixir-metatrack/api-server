# Copy to .env.remote and fill in trusted remote endpoints and credentials.
# This file is used only by `./dev/dev.sh api --remote .env.remote`; Compose never reads it.
# Remote mode disables Flyway startup migrations, but the API can still change remote data.

DB_USERNAME=
DB_PASSWORD=
JDBC_STRING=

KEYCLOAK_URL=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_USERNAME_CACHE_TTL=10M
KEYCLOAK_USERNAME_CACHE_MAX_SIZE=1000
KEYCLOAK_USER_SEARCH_CACHE_TTL=5M
KEYCLOAK_USER_SEARCH_CACHE_MAX_SIZE=1000

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_NAME=metatrack

FILE_RECONCILIATION_INTERVAL=10s
FILE_RECONCILIATION_BATCH_SIZE=100

TAXON_API_URL=http://localhost:8080