# Copy to .env.remote and fill in trusted remote endpoints and credentials.
# This file is used only by `./dev/dev.sh api --remote .env.remote`; Compose never reads it.
# Remote mode disables Flyway startup migrations, but the API can still change remote data.

DB_USERNAME=
DB_PASSWORD=
JDBC_STRING=

KEYCLOAK_URL=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_USERNAME_CACHE_TTL=10M
KEYCLOAK_USERNAME_CACHE_MAX_SIZE=1000
KEYCLOAK_USER_SEARCH_CACHE_TTL=5M
KEYCLOAK_USER_SEARCH_CACHE_MAX_SIZE=1000

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_NAME=metatrack

# Optional SFTPGo integration. Enable only when the API can reach a trusted private instance.
SFTPGO_ENABLED=false
SFTPGO_API_URL=
SFTPGO_ADMIN_USERNAME=
SFTPGO_ADMIN_PASSWORD=
SFTPGO_SFTP_HOST=
SFTPGO_SFTP_PORT=2022
SFTPGO_S3_ENDPOINT=
SFTPGO_S3_REGION=
SFTPGO_S3_ACCESS_KEY=
SFTPGO_S3_SECRET_KEY=
SFTPGO_S3_BUCKET_NAME=
SFTPGO_S3_PATH_STYLE_ACCESS=true
SFTPGO_HOOK_URL=
SFTPGO_HOOK_SECRET=
SFTPGO_RESUME_MAX_SIZE_BYTES=53687091200

UPLOAD_BATCH_MAX_FILES=100
UPLOAD_BATCH_MAX_FILE_SIZE_BYTES=53687091200
UPLOAD_BATCH_MAX_TRANSFERS_PER_BATCH=2
UPLOAD_BATCH_MAX_TOTAL_TRANSFERS=8
UPLOAD_BATCH_MAX_INGESTION_WORKERS=2
UPLOAD_BATCH_MULTIPART_COPY_PART_SIZE_BYTES=16777216
UPLOAD_BATCH_STAGING_BUDGET_BYTES=0
UPLOAD_BATCH_MAX_MANIFEST_BYTES=1048576
UPLOAD_BATCH_UPLOAD_WINDOW=P7D
UPLOAD_BATCH_FAILED_STAGING_RETENTION=P7D

FILE_RECONCILIATION_INTERVAL=10s
FILE_RECONCILIATION_BATCH_SIZE=100

TAXON_API_URL=http://localhost:8080