left to right direction

title Which Metatrack field ends up where in ISA-JSON

package "Metatrack" {
  map "Project" as P #F1F5F9 {
    name => text
    description => text
  }
  map "Sample" as S #E5F3EF {
    name => unique per project
    taxId => NCBI ID
    hostTaxId => NCBI ID
    otherFields => ~40 fixed fields, via field register
    sampleAccession => BioSamples
  }
  map "Custom field" as C #FFF3D6 {
    label => text
    definition => key, type, tooltip
    value => per sample
  }
  map "Assay" as A #E6EEF9 {
    name => unique per project
    libraryStrategy => e.g. WGS
    librarySource => ENA term
    librarySelection => ENA term
    libraryLayout => SINGLE / PAIRED
    libraryName => kit / protocol
    insertSize => number
    sequencingPlatform => e.g. ILLUMINA
    instrumentModel => e.g. NextSeq 500
    sequencingLaboratory => text
    accessions => study, experiment, run
  }
  map "File" as F #FCEBE1 {
    fileName => text
    md5 => checksum
    readRole => FORWARD / REVERSE / SINGLE
    status => e.g. PENDING
  }
}

package "ISA-JSON" {
  map "Investigation + Study" as IS #F1F5F9 {
    title => project name
    description => project description
  }
  map "Source  (one per sample)" as ISRC #E5F3EF {
    name => sample name
    organism => + tax_id, NCBITaxon term
  }
  map "Sample" as ISMP #E5F3EF {
    name => sample name
    host => host scientific name + host taxid
    characteristics => ENA names, e.g. collection date
    accession => MARS reuses it
    custom => one characteristic per custom field
  }
  map "characteristicCategories" as ICAT #FFF3D6 {
    label => category name
    comments => metatrack:fieldKey/Type/tooltip
  }
  map "Assay" as IA #E6EEF9 {
    measurementType => + technologyType, from strategy
    STUDY_TYPE => comment, from strategy
    technologyPlatform => platform + instrument
    comments => assayName, accessions
  }
  map "Library  (otherMaterial)" as ILIB #E6EEF9 {
    name => sample / assay
  }
  map "Process: library construction" as IPL #E6EEF9 {
    LIBRARY_STRATEGY => parameter value
    LIBRARY_SOURCE => parameter value
    LIBRARY_SELECTION => parameter value
    LIBRARY_LAYOUT => parameter value
    LIBRARY_CONSTRUCTION_PROTOCOL => parameter value
    NOMINAL_LENGTH => parameter value
    DESIGN_DESCRIPTION => generated
  }
  map "Process: nucleic acid sequencing" as IPS #E6EEF9 {
    PLATFORM => parameter value
    INSTRUMENT_MODEL => parameter value
    performer => sequencing lab
  }
  map "Raw Data File" as IF #FCEBE1 {
    name => file name
    checksum => comment "file checksum" (MD5)
    comments => readRole, uploadStatus
  }
}

