S::name --> ILIB::name #2F855A

C::label --> ICAT::label #B7791F
C::definition --> ICAT::comments #B7791F
C::value --> ISMP::custom #B7791F

A::name --> IA::comments #2B6CB0
A::name --> ILIB::name #2B6CB0
A::libraryStrategy --> IA::measurementType #2B6CB0
A::libraryStrategy --> IA::STUDY_TYPE #2B6CB0
A::libraryStrategy --> IPL::LIBRARY_STRATEGY #2B6CB0
A::librarySource --> IPL::LIBRARY_SOURCE #2B6CB0
A::librarySelection --> IPL::LIBRARY_SELECTION #2B6CB0
A::libraryLayout --> IPL::LIBRARY_LAYOUT #2B6CB0
A::libraryName --> IPL::LIBRARY_CONSTRUCTION_PROTOCOL #2B6CB0
A::insertSize --> IPL::NOMINAL_LENGTH #2B6CB0
A::sequencingPlatform --> IPS::PLATFORM #2B6CB0
A::sequencingPlatform --> IA::technologyPlatform #2B6CB0
A::instrumentModel --> IPS::INSTRUMENT_MODEL #2B6CB0
A::instrumentModel --> IA::technologyPlatform #2B6CB0
A::sequencingLaboratory --> IPS::performer #2B6CB0
