# Local-only development credentials. Do not reuse these outside this stack.
POSTGRES_HOST_PORT=15432
POSTGRES_DB=metatrack
POSTGRES_USER=metatrack
POSTGRES_PASSWORD=metatrack-local-only

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local-only
KEYCLOAK_HOST_PORT=18081
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=metatrack-local-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=metatrack-keycloak-local-only
KEYCLOAK_REALM=metatrack
KEYCLOAK_ADMIN_CLIENT_ID=metatrack-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=metatrack-local-admin-client-secret
KEYCLOAK_BASE_URL=http://localhost:${KEYCLOAK_HOST_PORT}
KEYCLOAK_URL=${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}

SILO_API_HOST_PORT=19000
SILO_CONSOLE_HOST_PORT=19001
SILO_ROOT_USER=metatrack-local
SILO_ROOT_PASSWORD=metatrack-silo-local-only
S3_ENDPOINT=http://localhost:${SILO_API_HOST_PORT}
S3_REGION=us-east-1
S3_ACCESS_KEY=${SILO_ROOT_USER}
S3_SECRET_KEY=${SILO_ROOT_PASSWORD}
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_NAME=metatrack

DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
JDBC_STRING=jdbc:postgresql://localhost:${POSTGRES_HOST_PORT}/${POSTGRES_DB}

FILE_RECONCILIATION_INTERVAL=10s
FILE_RECONCILIATION_BATCH_SIZE=100

KEYCLOAK_USERNAME_CACHE_TTL=10M
KEYCLOAK_USERNAME_CACHE_MAX_SIZE=1000
KEYCLOAK_USER_SEARCH_CACHE_TTL=5M
KEYCLOAK_USER_SEARCH_CACHE_MAX_SIZE=1000

# The taxonomy API remains external to the local dependency stack.
TAXON_API_URL=http://localhost:8080